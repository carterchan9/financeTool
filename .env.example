# Environment Variables Template
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# API Keys
ALPHA_VANTAGE_API_KEY=your_api_key_here
NEWS_API_KEY=your_api_key_here
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here

# Data Settings
DATA_DIR=./data
MODELS_DIR=./models
LOGS_DIR=./logs

# Model Settings
RANDOM_SEED=42
TEST_SIZE=0.2
VALIDATION_SIZE=0.1

# Database (for later phases)
DATABASE_URL=sqlite:///finance_ml.db
# DATABASE_URL=postgresql://user:password@localhost:5432/finance_ml_db

# API Settings (Phase 5)
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
DEBUG_MODE=False

# Cloud Settings (Phase 5)
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
S3_BUCKET=finance-ml-bucket

# MLflow Settings
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=finance-ml

# Feature Flags
ENABLE_GPU=False
ENABLE_DISTRIBUTED=False
CACHE_ENABLED=True

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
